# ==============================================================================
# Environment Configuration Template
# Multi-Agent Telugu Conversational AI Platform
# Copy this file to .env and configure your environment-specific values.
# NEVER commit .env with real credentials or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Server Settings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME="Multi-Agent Telugu Conversational AI"
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# ------------------------------------------------------------------------------
# Relational Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=telugu_ai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telugu_ai_db

# ------------------------------------------------------------------------------
# Vector Database (Qdrant)
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=telugu_documents

# ------------------------------------------------------------------------------
# LLM Provider Configuration (Primary: gemini | Alternatives: openai, groq, anthropic, ollama, mock)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Google Gemini API Key (Required for online LLM reasoning & answer synthesis)
GEMINI_API_KEY=

# Alternative Provider Keys & URLs (Optional)
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434


# ------------------------------------------------------------------------------
# Embedding Model Configuration
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024

# ------------------------------------------------------------------------------
# Retrieval & Ranking Settings (Advanced RAG)
# ------------------------------------------------------------------------------
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=4
MIN_SIMILARITY_SCORE=0.35
RERANKER_PROVIDER=local
RERANKER_MODEL=BAAI/bge-reranker-base

# ------------------------------------------------------------------------------
# Telugu Speech Services (STT & TTS)
# ------------------------------------------------------------------------------
# STT Configuration (Whisper large-v3-turbo)
STT_ENGINE=whisper_turbo
STT_MODEL_NAME=openai/whisper-large-v3-turbo
STT_LANGUAGE=te
STT_DEVICE=cpu

# TTS Configuration (IndicF5 + LoRA Adapter)
TTS_ENGINE=indicf5
TTS_MODEL_NAME=ai4bharat/IndicF5
TTS_SAMPLE_RATE=24000
TTS_DEFAULT_VOICE=telugu_female_1
TTS_ADAPTER=models/indicf5_telugu_lora

